---
import InterrogatorDashboard from '../components/InterrogatorDashboard.svelte';
 import '../styles/global.css' 
//testing
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Policy Search tool</title>
  </head>
  <body class="bg-[#fafafa] text-[#09090b] min-h-screen flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-3xl w-full mx-auto text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-[#e4e4e7] rounded-full mb-4 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.4)] animate-pulse"></span>
        <span class="text-xs font-semibold text-[#71717a]">Architectural Case Study</span>
      </div>
      
      <h1 class="text-4xl font-extrabold text-[#09090b] tracking-tight sm:text-5xl">
        Public Policy Search
      </h1>
      
      <p class="mt-3 text-base text-[#71717a] max-w-xl mx-auto leading-relaxed">
        An end-to-end full-stack demonstration combining deterministic local context extraction with modern API boundaries.
      </p>
    </div>

    <InterrogatorDashboard client:load />

  </body>
</html>

<style is:global>
  body {
    background-color: #fafafa;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .4; }
  }
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
